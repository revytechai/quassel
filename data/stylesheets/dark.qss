// Modern Dark stylesheet for Quassel IRC
// High contrast, modern aesthetics with smooth dark palette

Palette {
  marker-line: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop:0 #f38ba8, stop: 0.1 transparent);

  window: #1e1e2e;
  window-text: #cdd6f4;
  base: #181825;
  alternate-base: #1e1e2e;
  text: #cdd6f4;
  button: #313244;
  button-text: #cdd6f4;
  bright-text: #ffffff;
  light: #45475a;
  midlight: #313244;
  mid: #585b70;
  dark: #11111b;
  shadow: #11111b;
  highlight: #89b4fa;
  highlighted-text: #11111b;
  link: #89b4fa;
  link-visited: #b4befe;
  tooltip-base: #181825;
  tooltip-text: #cdd6f4;
}

// ChatView Colors
ChatView {
  background: #181825;
}

ChatLine[label="highlight"] {
  foreground: #ffffff;
  background: #582845;
  allow-foreground-override: false;
  allow-background-override: false;
}

ChatLine[label="selected"] {
  foreground: #ffffff;
  background: #363a4f;
  allow-foreground-override: false;
  allow-background-override: false;
}

ChatLine[label="hovered"] {
  font-style: underline;
}

ChatLine::timestamp {
  foreground: #6c7086;
}

ChatLine::url {
  foreground: #89b4fa;
}

ChatLine#plain { foreground: #cdd6f4; }
ChatLine#notice { foreground: #fab387; }
ChatLine#action { foreground: #89dceb; font-weight: bold; font-style: italic; }
ChatLine#nick { foreground: #cba6f7; }
ChatLine#mode { foreground: #74c7ec; font-weight: bold; }
ChatLine#join { foreground: #a6e3a1; }
ChatLine#part { foreground: #eba0ac; }
ChatLine#quit { foreground: #f38ba8; }
ChatLine#kick { foreground: #f38ba8; }
ChatLine#kill { foreground: #f38ba8; }
ChatLine#server { foreground: #fab387; }
ChatLine#info { foreground: #89dceb; }
ChatLine#error { foreground: #f38ba8; }
ChatLine#daychange { foreground: #6c7086; font-style: italic; }
ChatLine#topic { foreground: #f9e2af; }

// Sender Colors
ChatLine::sender#plain[sender="self"] { foreground: #89b4fa; font-weight: bold; }

ChatLine::sender#plain[sender="00"] { foreground: #f38ba8; }
ChatLine::sender#plain[sender="01"] { foreground: #fab387; }
ChatLine::sender#plain[sender="02"] { foreground: #f9e2af; }
ChatLine::sender#plain[sender="03"] { foreground: #a6e3a1; }
ChatLine::sender#plain[sender="04"] { foreground: #94e2d5; }
ChatLine::sender#plain[sender="05"] { foreground: #89dceb; }
ChatLine::sender#plain[sender="06"] { foreground: #74c7ec; }
ChatLine::sender#plain[sender="07"] { foreground: #89b4fa; }
ChatLine::sender#plain[sender="08"] { foreground: #b4befe; }
ChatLine::sender#plain[sender="09"] { foreground: #cba6f7; }
ChatLine::sender#plain[sender="0a"] { foreground: #f5c2e7; }
ChatLine::sender#plain[sender="0b"] { foreground: #eba0ac; }
ChatLine::sender#plain[sender="0c"] { foreground: #a6adc8; }
ChatLine::sender#plain[sender="0d"] { foreground: #58d68d; }
ChatLine::sender#plain[sender="0e"] { foreground: #f39c12; }
ChatLine::sender#plain[sender="0f"] { foreground: #00d2d3; }

// BufferView Colors
ChatListItem { foreground: #cdd6f4; }
ChatListItem[state="inactive"] { foreground: #585b70; }
ChatListItem[state="channel-event"] { foreground: #a6e3a1; }
ChatListItem[state="unread-message"] { foreground: #fab387; font-weight: bold; }
ChatListItem[state="highlighted"] { foreground: #f38ba8; font-weight: bold; }
BufferView {
  background: #181825;
  color: #cdd6f4;
  border: none;
}

// NickView Colors
NickListItem[type="category"] { foreground: #89b4fa; font-weight: bold; }
NickListItem[type="user"] { foreground: #cdd6f4; }
NickListItem[type="user", state="away"] { foreground: #585b70; font-style: italic; }
NickView {
  background: #181825;
  color: #cdd6f4;
  border: none;
}

// MultiLineEdit Input box
MultiLineEdit {
  background: #181825;
  color: #cdd6f4;
  border: 1px solid #313244;
  border-radius: 4px;
  padding: 4px;
}

MultiLineEdit:focus {
  border: 1px solid #89b4fa;
}

// Topic Bar
StyledLabel#topicLabel {
  background: #181825;
  color: #cdd6f4;
  border-bottom: 1px solid #313244;
  padding: 4px 6px;
}

// Window & Widget Controls
QMainWindow {
  background: #1e1e2e;
  color: #cdd6f4;
}

QWidget {
  color: #cdd6f4;
}

QMenuBar {
  background: #1e1e2e;
  color: #cdd6f4;
  border-bottom: 1px solid #313244;
}

QMenuBar::item:selected {
  background: #313244;
  border-radius: 4px;
}

QMenu {
  background: #1e1e2e;
  color: #cdd6f4;
  border: 1px solid #313244;
  border-radius: 4px;
  padding: 4px;
}

QMenu::item:selected {
  background: #313244;
  color: #89b4fa;
  border-radius: 3px;
}

QMenu::separator {
  background: #313244;
  height: 1px;
  margin: 4px 6px;
}

QToolBar {
  background: #1e1e2e;
  border-bottom: 1px solid #313244;
  spacing: 4px;
  padding: 2px;
}

QToolButton {
  background: transparent;
  color: #cdd6f4;
  border: none;
  border-radius: 4px;
  padding: 4px;
}

QToolButton:hover {
  background: #313244;
}

QToolButton:pressed {
  background: #45475a;
}

QToolButton:checked {
  background: #313244;
  border: 1px solid #89b4fa;
}

QStatusBar {
  background: #181825;
  color: #a6adc8;
  border-top: 1px solid #313244;
}

QDockWidget {
  color: #cdd6f4;
}

QDockWidget::title {
  background: #1e1e2e;
  color: #cdd6f4;
  padding: 5px;
  border-bottom: 1px solid #313244;
  font-weight: bold;
}

QTabBar::tab {
  background: #181825;
  color: #a6adc8;
  padding: 5px 12px;
  border: 1px solid #313244;
  border-bottom: none;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  margin-right: 2px;
}

QTabBar::tab:selected {
  background: #1e1e2e;
  color: #89b4fa;
  border-bottom: 2px solid #89b4fa;
}

QScrollBar:vertical {
  background: #181825;
  width: 10px;
  margin: 0;
}

QScrollBar::handle:vertical {
  background: #45475a;
  min-height: 24px;
  border-radius: 5px;
  margin: 2px;
}

QScrollBar::handle:vertical:hover {
  background: #585b70;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: none;
}

QScrollBar:horizontal {
  background: #181825;
  height: 10px;
  margin: 0;
}

QScrollBar::handle:horizontal {
  background: #45475a;
  min-width: 24px;
  border-radius: 5px;
  margin: 2px;
}

QScrollBar::handle:horizontal:hover {
  background: #585b70;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
  width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
  background: none;
}

QSplitter::handle {
  background: #313244;
}

QHeaderView::section {
  background: #1e1e2e;
  color: #cdd6f4;
  border: 1px solid #313244;
  padding: 4px;
}

QTreeView {
  background: #181825;
  color: #cdd6f4;
}

QTreeView::item:selected {
  background: #313244;
  color: #89b4fa;
}

QTreeView::item:hover {
  background: #252538;
}

QLineEdit {
  background: #181825;
  color: #cdd6f4;
  border: 1px solid #45475a;
  border-radius: 4px;
  padding: 4px 6px;
}

QLineEdit:focus {
  border-color: #89b4fa;
}

QSpinBox {
  background: #181825;
  color: #cdd6f4;
  border: 1px solid #45475a;
  border-radius: 4px;
  padding: 4px 6px;
}

QSpinBox:focus {
  border-color: #89b4fa;
}

QComboBox {
  background: #181825;
  color: #cdd6f4;
  border: 1px solid #45475a;
  border-radius: 4px;
  padding: 4px 8px;
}

QComboBox:focus {
  border-color: #89b4fa;
}

QComboBox QAbstractItemView {
  background: #1e1e2e;
  color: #cdd6f4;
  border: 1px solid #45475a;
  selection-background-color: #313244;
  selection-color: #89b4fa;
}

QPushButton {
  background: #313244;
  color: #cdd6f4;
  border: 1px solid #45475a;
  border-radius: 4px;
  padding: 5px 14px;
}

QPushButton:hover {
  background: #45475a;
  border-color: #89b4fa;
}

QPushButton:pressed {
  background: #585b70;
}

QDialog {
  background: #1e1e2e;
  color: #cdd6f4;
}

QGroupBox {
  border: 1px solid #313244;
  border-radius: 6px;
  margin-top: 10px;
  padding-top: 10px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 10px;
  padding: 0 4px;
  color: #89b4fa;
}

QToolTip {
  background: #181825;
  color: #cdd6f4;
  border: 1px solid #45475a;
  border-radius: 4px;
  padding: 4px;
}
